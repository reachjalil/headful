{
  "name": "@headfulcloud/admin-utilities",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Salesforce admin utilities for Headful",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "headful.mod.json",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": "./headful.mod.json",
    "./package.json": "./package.json",
    "./web": "./src/web/index.tsx"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vp test run --config ../../vite.config.ts --dir ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "codemirror": "6.0.2",
    "katex": "0.16.47",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@t3tools/contracts": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "~19.3.0",
    "esbuild": "0.28.2",
    "react": "19.2.6",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "react": "19.2.6"
  }
}
