{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "admin-utilities",
  "name": "Admin Utilities",
  "description": "Read-only Salesforce inspection, SOQL, schema exploration and diagnostics in one configurable native workspace.",
  "version": "0.1.0",
  "packageName": "@headfulcloud/admin-utilities",
  "license": "MIT",
  "source": "bundled",
  "sourceClassification": "open-source",
  "entryPoints": {
    "server": "./dist/index.js",
    "renderer": "./src/web/index.tsx"
  },
  "defaultEnabled": true,
  "dependencies": [],
  "requiredFeatures": ["org-management"],
  "permissions": [
    "salesforce:read",
    "salesforce:records",
    "salesforce:query",
    "salesforce:schema",
    "salesforce:diagnostics",
    "salesforce:org-navigation",
    "local:utility-preferences",
    "local:workspace",
    "local:settings"
  ],
  "settings": [
    {
      "key": "compact-results",
      "label": "Use compact result tables",
      "type": "boolean",
      "defaultValue": true
    }
  ],
  "contributions": {
    "features": [
      {
        "id": "admin-utilities/org-shortcuts",
        "name": "Org shortcuts",
        "description": "Verified org navigation and personal setup links.",
        "availability": "available",
        "defaultEnabled": true,
        "dependencies": ["org-management"],
        "configuration": ["Salesforce CLI connection"],
        "permissions": [],
        "route": "utilities",
        "lifecycle": "on-demand"
      },
      {
        "id": "admin-utilities/record-inspector",
        "name": "Record inspector",
        "description": "Read accessible fields outside the page layout.",
        "availability": "available",
        "defaultEnabled": true,
        "dependencies": ["org-management"],
        "configuration": ["Salesforce CLI connection"],
        "permissions": [],
        "route": "utilities",
        "lifecycle": "on-demand"
      },
      {
        "id": "admin-utilities/soql",
        "name": "SOQL workspace",
        "description": "Run bounded read-only queries, save them and export results.",
        "availability": "available",
        "defaultEnabled": true,
        "dependencies": ["org-management"],
        "configuration": ["Salesforce CLI connection"],
        "permissions": [],
        "route": "utilities",
        "lifecycle": "on-demand"
      },
      {
        "id": "admin-utilities/schema",
        "name": "Object & field explorer",
        "description": "Browse accessible objects, fields and relationships.",
        "availability": "available",
        "defaultEnabled": true,
        "dependencies": ["org-management"],
        "configuration": ["Salesforce CLI connection"],
        "permissions": [],
        "route": "utilities",
        "lifecycle": "on-demand"
      },
      {
        "id": "admin-utilities/diagnostics",
        "name": "Org diagnostics",
        "description": "Read supported limits, storage, jobs and debug logs.",
        "availability": "available",
        "defaultEnabled": true,
        "dependencies": ["org-management"],
        "configuration": ["Salesforce CLI connection"],
        "permissions": [],
        "route": "utilities",
        "lifecycle": "on-demand"
      }
    ],
    "components": [
      {
        "id": "admin-utilities/org-shortcuts",
        "kind": "panel"
      },
      {
        "id": "admin-utilities/record-inspector",
        "kind": "panel"
      },
      {
        "id": "admin-utilities/soql-workspace",
        "kind": "panel"
      },
      {
        "id": "admin-utilities/schema-explorer",
        "kind": "panel"
      },
      {
        "id": "admin-utilities/diagnostics",
        "kind": "panel"
      },
      {
        "id": "admin-utilities/search",
        "kind": "header-control"
      },
      {
        "id": "admin-utilities/favorites",
        "kind": "header-control"
      },
      {
        "id": "admin-utilities/status",
        "kind": "header-control"
      },
      {
        "id": "admin-utilities/actions",
        "kind": "header-control"
      },
      {
        "id": "admin-utilities/secondary",
        "kind": "header-control"
      }
    ],
    "navigation": [
      {
        "id": "admin-utilities/orgs",
        "name": "Org shortcuts",
        "componentId": "admin-utilities/org-shortcuts",
        "icon": "cloud",
        "order": 10,
        "requiresOrg": true,
        "requiredFeatures": ["admin-utilities/org-shortcuts"]
      },
      {
        "id": "admin-utilities/records",
        "name": "Record inspector",
        "componentId": "admin-utilities/record-inspector",
        "icon": "search",
        "order": 20,
        "requiresOrg": true,
        "requiredFeatures": ["admin-utilities/record-inspector"]
      },
      {
        "id": "admin-utilities/query",
        "name": "SOQL workspace",
        "componentId": "admin-utilities/soql-workspace",
        "icon": "table",
        "order": 30,
        "requiresOrg": true,
        "requiredFeatures": ["admin-utilities/soql"]
      },
      {
        "id": "admin-utilities/schema",
        "name": "Object & field explorer",
        "componentId": "admin-utilities/schema-explorer",
        "icon": "database",
        "order": 40,
        "requiresOrg": true,
        "requiredFeatures": ["admin-utilities/schema"]
      },
      {
        "id": "admin-utilities/diagnostics",
        "name": "Org diagnostics",
        "componentId": "admin-utilities/diagnostics",
        "icon": "activity",
        "order": 50,
        "requiresOrg": true,
        "requiredFeatures": ["admin-utilities/diagnostics"]
      }
    ],
    "panels": [
      {
        "id": "admin-utilities/org-shortcuts",
        "name": "Org shortcuts",
        "componentId": "admin-utilities/org-shortcuts",
        "workspaceIds": ["admin-utilities/orgs"],
        "requiredFeatures": ["admin-utilities/org-shortcuts"]
      },
      {
        "id": "admin-utilities/record-inspector",
        "name": "Record inspector",
        "componentId": "admin-utilities/record-inspector",
        "workspaceIds": ["admin-utilities/records"],
        "requiredFeatures": ["admin-utilities/record-inspector"]
      },
      {
        "id": "admin-utilities/soql-workspace",
        "name": "SOQL workspace",
        "componentId": "admin-utilities/soql-workspace",
        "workspaceIds": ["admin-utilities/query"],
        "requiredFeatures": ["admin-utilities/soql"]
      },
      {
        "id": "admin-utilities/schema-explorer",
        "name": "Object & field explorer",
        "componentId": "admin-utilities/schema-explorer",
        "workspaceIds": ["admin-utilities/schema"],
        "requiredFeatures": ["admin-utilities/schema"]
      },
      {
        "id": "admin-utilities/diagnostics",
        "name": "Org diagnostics",
        "componentId": "admin-utilities/diagnostics",
        "workspaceIds": ["admin-utilities/diagnostics"],
        "requiredFeatures": ["admin-utilities/diagnostics"]
      }
    ],
    "headerControls": [
      {
        "id": "admin-utilities/search",
        "name": "Commands & search",
        "componentId": "admin-utilities/search",
        "placement": "primary",
        "defaultVisible": true,
        "order": 10,
        "workspaceIds": [],
        "requiredFeatures": []
      },
      {
        "id": "admin-utilities/favorites",
        "name": "Favorite setup links",
        "componentId": "admin-utilities/favorites",
        "placement": "primary",
        "defaultVisible": true,
        "order": 20,
        "workspaceIds": [],
        "requiredFeatures": ["admin-utilities/org-shortcuts"]
      },
      {
        "id": "admin-utilities/status",
        "name": "Org status",
        "componentId": "admin-utilities/status",
        "placement": "primary",
        "defaultVisible": true,
        "order": 30,
        "workspaceIds": [],
        "requiredFeatures": ["admin-utilities/diagnostics"]
      },
      {
        "id": "admin-utilities/actions",
        "name": "Workspace actions",
        "componentId": "admin-utilities/actions",
        "placement": "overflow",
        "defaultVisible": true,
        "order": 40,
        "workspaceIds": [],
        "requiredFeatures": ["admin-utilities/org-shortcuts"]
      },
      {
        "id": "admin-utilities/secondary",
        "name": "Saved queries",
        "componentId": "admin-utilities/secondary",
        "placement": "secondary",
        "defaultVisible": true,
        "order": 50,
        "workspaceIds": ["admin-utilities/query"],
        "requiredFeatures": ["admin-utilities/soql"]
      }
    ],
    "commands": [
      {
        "id": "admin-utilities/open-org",
        "name": "Open selected org",
        "description": "Open the explicitly selected Salesforce org.",
        "parameters": [
          {
            "key": "org-id",
            "type": "string",
            "required": true
          }
        ],
        "requiredFeatures": ["admin-utilities/org-shortcuts"]
      },
      {
        "id": "admin-utilities/open-setup",
        "name": "Open Salesforce Setup",
        "description": "Open Setup in the explicitly selected org.",
        "parameters": [
          {
            "key": "org-id",
            "type": "string",
            "required": true
          }
        ],
        "requiredFeatures": ["admin-utilities/org-shortcuts"]
      },
      {
        "id": "admin-utilities/open-users-setup",
        "name": "Open User Setup",
        "description": "Open Salesforce user administration for this org.",
        "parameters": [
          {
            "key": "org-id",
            "type": "string",
            "required": true
          }
        ],
        "requiredFeatures": ["admin-utilities/org-shortcuts"]
      },
      {
        "id": "admin-utilities/open-permission-sets-setup",
        "name": "Open Permission Set Setup",
        "description": "Open Salesforce permission-set administration for this org.",
        "parameters": [
          {
            "key": "org-id",
            "type": "string",
            "required": true
          }
        ],
        "requiredFeatures": ["admin-utilities/org-shortcuts"]
      },
      {
        "id": "admin-utilities/connection-status",
        "name": "Inspect connection status",
        "description": "Show the selected imported connection identity and recorded status.",
        "parameters": [
          {
            "key": "org-id",
            "type": "string",
            "required": true
          }
        ],
        "requiredFeatures": ["admin-utilities/org-shortcuts"]
      }
    ],
    "actions": [
      {
        "id": "admin-utilities/open-org",
        "name": "Open org",
        "commandId": "admin-utilities/open-org",
        "icon": "external-link",
        "placement": "overflow",
        "order": 10,
        "workspaceIds": [],
        "requiresOrg": true,
        "requiredFeatures": ["admin-utilities/org-shortcuts"]
      },
      {
        "id": "admin-utilities/open-setup",
        "name": "Salesforce Setup",
        "commandId": "admin-utilities/open-setup",
        "icon": "external-link",
        "placement": "overflow",
        "order": 20,
        "workspaceIds": [],
        "requiresOrg": true,
        "requiredFeatures": ["admin-utilities/org-shortcuts"]
      }
    ],
    "surfaces": [
      {
        "id": "overview",
        "name": "About Admin Utilities",
        "description": "Open-source module status and scope.",
        "requiredFeatures": []
      }
    ],
    "routes": [
      {
        "id": "overview",
        "name": "Admin Utilities",
        "path": "/extensions/admin-utilities/overview",
        "surfaceId": "overview",
        "requiredFeatures": []
      }
    ],
    "hooks": ["activate", "deactivate", "feature-changed"]
  }
}
