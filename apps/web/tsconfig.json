{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "erasableSyntaxOnly": false,
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "~/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        // Diagnostic severities are deep-merged with tsconfig.base.json; list only web-specific overrides here.
        "diagnosticSeverity": {
          "globalDate": "off",
          "globalConsole": "off",
          "globalRandom": "off",
          "globalTimers": "off",
          "globalFetch": "off"
        }
      }
    ]
  },
  "include": [
    "src",
    "vite",
    "vite.config.ts",
    "vercel.ts",
    "test",
    "scripts/warm-dep-cache.ts",
    "../../scripts/lib/public-config.ts",
    "../../scripts/lib/third-party-licenses.ts",
    "../../packages/contracts/src/headful.ts",
    "../../packages/contracts/src/headful-extensions.ts",
    "../../packages/contracts/src/headful-utilities.ts",
    "../../packages/headful-admin-utilities/src/web/**/*.ts",
    "../../packages/headful-admin-utilities/src/web/**/*.tsx",
    "../../packages/contracts/src/headful-workspace/**/*.ts"
  ]
}
