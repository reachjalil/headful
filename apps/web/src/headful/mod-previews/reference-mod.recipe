await app.reset();
await app.mock({"fixture":"ready"});
await app.flow({"id":"reference-mod"});
await app.assert({"path":"step","equals":"counter"});
await app.click({"testId":"editor-document-split"});
await app.click({"testId":"editor-document-layout"});
await app.click({"testId":"editor-document-preview-first"});
await app.screenshot();
await app.click({"testId":"editor-action-org.example.hello/hello"});
await app.click({"testId":"editor-refresh-view"});
await app.click({"testId":"editor-tools-menu"});
await app.screenshot();
await app.press({"key":"Escape"});
await app.click({"testId":"admin-tool-query"});
await app.type({"testId":"admin-query-editor","text":"SELECT Id, Name FROM Account LIMIT 10"});
await app.screenshot();
await app.click({"testId":"editor-tools-menu"});
await app.type({"testId":"editor-tools-search","text":"counter"});
await app.press({"key":"Enter"});
await app.click({"testId":"editor-back"});
await app.click({"testId":"editor-forward"});
await app.assert({"path":"alerts","equals":0});
await app.screenshot();
