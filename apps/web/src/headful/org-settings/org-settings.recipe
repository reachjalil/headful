await app.reset();
await app.mock({"fixture":"ready"});
await app.flow({"id":"org-settings"});
await app.assert({"path":"step","equals":"overview"});
await app.screenshot();
await app.click({"testId":"org-settings-limits"});
await app.click({"testId":"org-settings-license-permission-set"});
await app.click({"testId":"org-settings-metadata"});
await app.click({"testId":"org-settings-type-customobject"});
await app.screenshot();
await app.click({"testId":"org-settings-environments"});
await app.assert({"path":"step","equals":"environments"});
await app.click({"testId":"org-settings-cli"});
await app.assert({"path":"step","equals":"cli"});
await app.screenshot();
await app.click({"testId":"org-settings-appearance"});
await app.click({"testId":"appearance-light"});
await app.screenshot();
await app.click({"testId":"appearance-system"});
await app.click({"testId":"org-settings-documentation"});
await app.assert({"path":"step","equals":"documentation"});
await app.assert({"path":"alerts","equals":0});
await app.screenshot();
